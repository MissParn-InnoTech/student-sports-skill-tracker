# Connection string ของ PostgreSQL (ใส่จริงในไฟล์ .env หรือ Environment Variables บน Vercel)
# ตัวอย่าง Local: postgresql://postgres:postgres@localhost:5432/sportstracker
# ตัวอย่าง Vercel Postgres / Neon / Supabase: จะได้ค่านี้จากหน้า Dashboard ของบริการนั้น ๆ
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
